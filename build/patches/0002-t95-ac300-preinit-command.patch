+// SPDX-License-Identifier: GPL-2.0+
+/* T95-only AC300 cold-start experiment, executed in U-Boot proper, never SPL.
+ * Register sequence: NickAlilovic/build 19f5ca1, patches 100 and 106.
+ * Separate MDIO configuration address: AC300 driver, armbian/build #9952.
+ * All accesses below are volatile; SID is read only. No block-device access.
+ */
+#include <common.h>
+#include <command.h>
+#include <asm/global_data.h>
+#include <asm/gpio.h>
+#include <sunxi_gpio.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/libfdt.h>
+#include <wait_bit.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define REG(a) ((void __iomem *)(unsigned long)(a))
+#define GMAC 0x05030000
+#define MDC (GMAC + 0x48)
+#define MDD (GMAC + 0x4c)
+#define CFG_ADDR 16
+#define PHY_ADDR 0
+
+/* 300 MHz / 128 < 2.5 MHz. Every transaction has a bounded timeout. */
+static int mdio_read_t95(int addr, int reg)
+{
+	int ret = wait_for_bit_le32(REG(MDC), BIT(0), false, 100, false);
+
+	if (ret)
+		return ret;
+	writel((3 << 20) | (addr << 12) | (reg << 4) | 1, REG(MDC));
+	ret = wait_for_bit_le32(REG(MDC), BIT(0), false, 100, false);
+	return ret ? ret : readl(REG(MDD)) & 0xffff;
+}
+
+static int mdio_write_t95(int addr, int reg, u16 value)
+{
+	int ret = wait_for_bit_le32(REG(MDC), BIT(0), false, 100, false);
+
+	if (ret)
+		return ret;
+	writel(value, REG(MDD));
+	writel((3 << 20) | (addr << 12) | (reg << 4) | 3, REG(MDC));
+	return wait_for_bit_le32(REG(MDC), BIT(0), false, 100, false);
+}
+
+static int read_id_t95(int addr, u32 *id)
+{
+	int hi = mdio_read_t95(addr, 2), lo;
+
+	if (hi < 0)
+		return hi;
+	lo = mdio_read_t95(addr, 3);
+	if (lo < 0)
+		return lo;
+	*id = ((u32)hi << 16) | lo;
+	return 0;
+}
+
+/* A failed MDIO write must never silently advance the power-up sequence. */
+#define WR(a, r, v) do { \
+	ret = mdio_write_t95(a, r, v); \
+	if (ret) { printf("T95-AC300: MDIO write failed addr=%d reg=%02x (%d)\n", \
+			   a, r, ret); return CMD_RET_FAILURE; } \
+} while (0)
+
+static int do_t95_ac300(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	u32 sid, id, syscon;
+	int pin, val, ret;
+
+	if (fdt_node_check_compatible(gd->fdt_blob, 0, "mbox,t95-axp313")) {
+		puts("T95-AC300: wrong board, skipped\n");
+		return CMD_RET_FAILURE;
+	}
+	sid = readl(REG(0x0300622c)) & 0xffff;
+	printf("T95-AC300: calibration=%04x AC300=%u fixed=%u\n",
+	       sid, !!(sid & BIT(8)), !!(sid & BIT(9)));
+	if (!(sid & BIT(8))) {
+		puts("T95-AC300: SID does not identify AC300, skipped\n");
+		return CMD_RET_FAILURE;
+	}
+
+	/* PA0..9 internal RMII, PA12 PWM5. Keep every other pin unchanged. */
+	for (pin = 0; pin <= 9; pin++)
+		sunxi_gpio_set_cfgpin(SUNXI_GPA(pin), 2);
+	sunxi_gpio_set_cfgpin(SUNXI_GPA(12), 2);
+	/* PWM bus gate/reset; PWM4/5 common clock: gate + oscillator bypass.
+	 * PWM5 period register is retained from the published reference sequence.
+	 */
+	setbits_le32(REG(0x030017ac), BIT(16) | BIT(0));
+	writel(0x80004, REG(0x0300a104));
+	clrsetbits_le32(REG(0x0300a028), GENMASK(8, 7) | GENMASK(3, 0), 0x50);
+	setbits_le32(REG(0x0300a040), BIT(5));
+	/* Release GMAC1 bus reset and enable its bus clock; preserve GMAC0. */
+	setbits_le32(REG(0x0300197c), BIT(17) | BIT(1));
+	syscon = readl(REG(0x03000034));
+	printf("T95-AC300: syscon34 before=%08x\n", syscon);
+	/* Same RMII source/delay setting as the existing Linux DTB/driver. */
+	syscon &= ~(BIT(15) | BIT(13) | GENMASK(12, 5) | BIT(2) | GENMASK(1, 0));
+	syscon |= BIT(13) | (7 << 10) | (31 << 5) | 1;
+	writel(syscon, REG(0x03000034));
+	mdelay(10);
+	printf("T95-AC300: PWM_BGR=%08x PCCR45=%08x PER=%08x EMAC_BGR=%08x syscon34=%08x\n",
+	       readl(REG(0x030017ac)), readl(REG(0x0300a028)),
+	       readl(REG(0x0300a040)), readl(REG(0x0300197c)), readl(REG(0x03000034)));
+
+	ret = read_id_t95(CFG_ADDR, &id);
+	if (ret) {
+		printf("T95-AC300: control MDIO timeout (%d)\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	printf("T95-AC300: control@16 ID=%08x\n", id);
+	if (id != 0xc0000000) {
+		puts("T95-AC300: unexpected control ID, no PHY writes\n");
+		return CMD_RET_FAILURE;
+	}
+	WR(CFG_ADDR, 0, 0x1f83);
+	mdelay(10);
+	WR(CFG_ADDR, 0, 0x1fb7);
+	mdelay(10);
+	WR(CFG_ADDR, 5, 0xa81f);
+	WR(CFG_ADDR, 6, ((sid + 3) & 15) << 12 | BIT(11) | BIT(1));
+	mdelay(500);
+	ret = read_id_t95(PHY_ADDR, &id);
+	if (ret || (id & 0xfffffff0) != 0x00441400) {
+		printf("T95-AC300: EPHY@0 not ready ID=%08x ret=%d\n", id, ret);
+		return CMD_RET_FAILURE;
+	}
+	printf("T95-AC300: EPHY@0 ID=%08x\n", id);
+	/* Published SID-dependent transceiver setup, restricted to the EPHY. */
+	WR(PHY_ADDR, 0x1f, 0x0100);
+	WR(PHY_ADDR, 0x12, 0x4824);
+	WR(PHY_ADDR, 0x1f, 0x0200);
+	WR(PHY_ADDR, 0x18, 0x0000);
+	WR(PHY_ADDR, 0x1f, 0x0600);
+	WR(PHY_ADDR, 0x14, sid & BIT(9) ? 0x7809 : 0x708b);
+	WR(PHY_ADDR, 0x13, 0xf000);
+	if (sid & BIT(9)) {
+		WR(PHY_ADDR, 0x10, 0x5523);
+	}
+	WR(PHY_ADDR, 0x15, sid & BIT(9) ? 0x3533 : 0x1530);
+	WR(PHY_ADDR, 0x1f, 0x0800);
+	if (sid & BIT(9)) {
+		WR(PHY_ADDR, 0x1d, 0x0844);
+	}
+	WR(PHY_ADDR, 0x18, 0x00bc);
+	WR(PHY_ADDR, 0x1f, 0x0100);
+	val = mdio_read_t95(PHY_ADDR, 0x17);
+	if (val < 0)
+		return CMD_RET_FAILURE;
+	WR(PHY_ADDR, 0x17, val & ~BIT(3));
+	WR(PHY_ADDR, 0x1f, 0);
+	WR(PHY_ADDR, 0x0d, 7);
+	WR(PHY_ADDR, 0x0e, 0x3c);
+	WR(PHY_ADDR, 0x0d, BIT(14) | 7);
+	val = mdio_read_t95(PHY_ADDR, 0x0e);
+	if (val < 0)
+		return CMD_RET_FAILURE;
+	WR(PHY_ADDR, 0x0e, val & ~BIT(1));
+	/* Prove the MAC reset can now finish, before handing ownership to Linux. */
+	setbits_le32(REG(GMAC + 4), BIT(0));
+	ret = wait_for_bit_le32(REG(GMAC + 4), BIT(0), false, 100, false);
+	printf("T95-AC300: MAC reset %s (%d)\n", ret ? "FAILED" : "OK", ret);
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(t95_ac300, 1, 0, do_t95_ac300,
+	   "initialize T95 AC300 and report PHY ID / MAC reset", "");
